<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <!-- ${aspnet-*} layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <!-- Every line carries the request's correlation id - the same value the
         Step 12 CorrelationIdMiddleware puts in HttpContext.Items["CorrelationId"]
         and returns in the X-Correlation-ID response header. -->
    <target xsi:type="File" name="logfile"
            fileName="${basedir}/logs/camping-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | corr=${aspnet-item:variable=CorrelationId:whenEmpty=-} | ${logger:shortName=true} | ${message}${onexception:inner= | ${exception:format=type,message,stacktrace:maxInnerExceptionLevel=3}}" />

    <target xsi:type="Console" name="logconsole"
            layout="${time} | ${level:uppercase=true:padding=-5} | corr=${aspnet-item:variable=CorrelationId:whenEmpty=-} | ${logger:shortName=true} | ${message}${onexception:inner= | ${exception:format=type,message}}" />
  </targets>

  <rules>
    <!-- Framework categories below Warning are dropped (blackhole). This keeps
         the log readable and, importantly, stops chatty framework sinks (EF Core
         command text, model binding, Kestrel) from ever writing request data. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Everything else (the application, and framework Warning/Error): logged. -->
    <logger name="*" minlevel="Info" writeTo="logfile,logconsole" />
  </rules>
</nlog>
